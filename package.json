{
  "name": "multipag",
  "version": "1.0.0",
  "private": true,
  "description": "MultiPag - plataforma de cobrança (trabalho de Padrões de Projeto / reuso de software)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "next": "^16.4.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
